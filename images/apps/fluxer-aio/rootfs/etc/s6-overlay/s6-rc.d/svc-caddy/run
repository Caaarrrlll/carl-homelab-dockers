#!/command/with-contenv bash
# s6 longrun, started after init-fluxer-aio (see dependencies.d).
# Internal router on :8080 (plain HTTP; TLS is done by the reverse proxy).

set -e

# --- Log prefix ----------------------------------------------------------------
# Prefix every output line with the service name in the container log.
exec > >(exec sed -u "s/^/[router] /") 2>&1

# --- Environment ---------------------------------------------------------------
export XDG_DATA_HOME=/data/caddy/data
export XDG_CONFIG_HOME=/data/caddy/config

# --- Start ---------------------------------------------------------------------
exec s6-setuidgid fluxer \
    caddy run \
    --config /etc/fluxer-aio/Caddyfile \
    --adapter caddyfile
