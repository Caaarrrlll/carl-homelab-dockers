#!/command/with-contenv bash
# s6 longrun, started after init-fluxer-aio (see dependencies.d).
# Meilisearch, settings as in the bundle; data in /data/meilisearch.

set -e

# --- Log prefix ----------------------------------------------------------------
# Prefix every output line with the service name in the container log.
exec > >(exec sed -u "s/^/[meilisearch] /") 2>&1

# --- Environment ---------------------------------------------------------------
export MEILI_ENV="${FLUXER_MEILISEARCH_ENV:-production}"
export MEILI_NO_ANALYTICS="${FLUXER_MEILISEARCH_NO_ANALYTICS:-true}"
export MEILI_UPGRADE_DB=true
export MEILI_MAX_INDEXING_MEMORY="${FLUXER_MEILISEARCH_MAX_INDEXING_MEMORY:-256mb}"
export MEILI_MAX_INDEXING_THREADS="${FLUXER_MEILISEARCH_MAX_INDEXING_THREADS:-2}"
export MEILI_LOG_LEVEL="${FLUXER_MEILISEARCH_LOG_LEVEL:-WARN}"
export MEILI_HTTP_ADDR=127.0.0.1:7700
export MEILI_DB_PATH=/data/meilisearch/data.ms
export MEILI_DUMP_DIR=/data/meilisearch/dumps
export MEILI_SNAPSHOT_DIR=/data/meilisearch/snapshots

# --- Start ---------------------------------------------------------------------
cd /data/meilisearch
exec s6-setuidgid fluxer \
    meilisearch
