#!/command/with-contenv bash
# s6 longrun, started after init-fluxer-aio (see dependencies.d).
# LiveKit voice/video; config written by fluxer-aio-init (as the bundle, via LIVEKIT_CONFIG).

set -e

# --- Log prefix ----------------------------------------------------------------
# Prefix every output line with the service name in the container log.
exec > >(exec sed -u "s/^/[livekit] /") 2>&1

# --- Environment ---------------------------------------------------------------
export GOMEMLIMIT="${FLUXER_LIVEKIT_GOMEMLIMIT:-435MiB}"
export LIVEKIT_KEYS="${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}"
LIVEKIT_CONFIG="$(cat /run/fluxer-aio/livekit.yaml)"
export LIVEKIT_CONFIG

# --- Start ---------------------------------------------------------------------
exec s6-setuidgid fluxer \
    livekit-server
