#!/command/with-contenv bash
# s6 longrun, started after init-fluxer-aio (see dependencies.d).
# Fluxer gateway (Erlang). Upstream sets nofile 65536 for this container.

set -e

# --- Log prefix ----------------------------------------------------------------
# Prefix every output line with the service name in the container log.
exec > >(exec sed -u "s/^/[gateway] /") 2>&1

# --- Open-file limit -----------------------------------------------------------
if ! ulimit -n 65536 2>/dev/null; then
    echo "could not raise the open-file limit to 65536; add --ulimit nofile=65536:65536"
fi

# --- Start ---------------------------------------------------------------------
cd /opt/fluxer_gateway
exec s6-setuidgid fluxer \
    fluxer-aio-env gateway \
    /opt/fluxer_gateway/bin/docker_entrypoint.sh
