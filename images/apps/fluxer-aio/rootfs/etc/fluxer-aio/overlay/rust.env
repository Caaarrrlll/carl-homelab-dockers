# fluxer-server: all Rust services in one process (upstream
# rust-server.compose.yml). The generated env keeps upstream's service ports
# (snowflakes 18090, users 18091, messages 18092, gifs 18093, unfurl 18094,
# admin 18083); only app-proxy moves off 8080, which the router uses.
FLUXER_SERVER_APP_PROXY__FLUXER_APP_PROXY_PORT=18086
# Upstream sets the filesystem store on its separate admin container only.
FLUXER_SERVER_ADMIN__FLUXER_STORAGE_BACKEND=filesystem
FLUXER_SERVER_ADMIN__FLUXER_STORAGE_ROOT=/data/objects
LD_PRELOAD=libjemalloc.so.2
MALLOC_CONF=background_thread:true,metadata_thp:auto,dirty_decay_ms:5000,muzzy_decay_ms:5000
