# media-proxy (Rust). Values from its upstream image config, plus a port,
# loopback-only bind and on-disk storage. Upstream mounts a volume on /tmp for
# the upload relay spool (up to 2 GB), so TMPDIR points into /data.
FLUXER_MEDIA_PROXY_HOST=127.0.0.1
FLUXER_MEDIA_PROXY_PORT=18085
FLUXER_MEDIA_PROXY_STORAGE_BACKEND=local
FLUXER_MEDIA_PROXY_STORAGE_ROOT=/data/objects
TMPDIR=/data/tmp/media-proxy
LD_PRELOAD=libjemalloc.so.2
MALLOC_CONF=background_thread:true,metadata_thp:auto,dirty_decay_ms:5000,muzzy_decay_ms:5000
VIPS_CONCURRENCY=1
VIPS_DISC_THRESHOLD=1g
G_MESSAGES_DEBUG=
