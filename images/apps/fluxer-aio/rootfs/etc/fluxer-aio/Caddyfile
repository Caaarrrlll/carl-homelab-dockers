# fluxer-aio internal router (plain HTTP on :8080, no TLS).
#
# Replaces two upstream containers: the `edge` Caddy in proxy mode
# (docker-compose.proxy.yml: no TLS, trusted private proxies) and the
# `static-proxy` Caddy that serves /srv/fluxer-static. Routes, headers and
# health endpoint follow upstream's Caddyfiles (release in upstream/RELEASE);
# upstream addresses are fluxer-aio's 127.0.0.1 ports (README "Ports").
# The operator's own reverse proxy terminates TLS and forwards everything here.

{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		protocols h1 h2c
	}
}

(upstream) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up -Forwarded
	}
}

(static_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Access-Control-Allow-Origin *
		Cache-Control "public, max-age=3600, must-revalidate"
		-Server
	}
	@hashedBadges path_regexp ^/badges/[0-9a-f]{16}\.(webp|png)$
	header @hashedBadges {
		defer
		Cache-Control "public, max-age=31536000, immutable"
	}
}

:8080 {
	encode zstd gzip

	handle /_health {
		header Cache-Control no-store
		respond "OK" 200
	}
	handle_path /api/* {
		import upstream 127.0.0.1:18080
	}
	handle /gateway {
		rewrite * /
		import upstream 127.0.0.1:18081
	}
	handle_path /gateway/* {
		import upstream 127.0.0.1:18081
	}
	handle_path /media/* {
		import upstream 127.0.0.1:18085
	}
	handle_path /livekit/* {
		import upstream 127.0.0.1:7880
	}
	handle /admin {
		rewrite * /
		import upstream 127.0.0.1:18083
	}
	handle_path /admin/* {
		import upstream 127.0.0.1:18083
	}
	@staticAssets path /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/*
	handle @staticAssets {
		@hidden path /.*
		respond @hidden "Not Found" 404
		root * /srv/fluxer-static
		import static_headers
		file_server
	}
	handle /.well-known/fluxer {
		import upstream 127.0.0.1:18080
	}
	handle /.well-known/webfinger {
		import upstream 127.0.0.1:18080
	}
	handle {
		import upstream 127.0.0.1:18086
	}
}
