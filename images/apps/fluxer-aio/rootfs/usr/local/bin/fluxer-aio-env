#!/bin/bash
# fluxer-aio-env <service> <command> [args...]
#
# Builds the environment the official Compose bundle would give <service>,
# then execs <command>:
#   1. /etc/fluxer-aio/env/<service>.env (generated by upstream/gen-env.py):
#      `!NAME=value` lines are literal defaults; `KEY=EXPR` lines are Compose
#      interpolations, each evaluated against the STARTING environment
#      (template values + generated secrets), like Compose evaluates `.env`.
#   2. /etc/fluxer-aio/overlay/common.env and <service>.env: fixed fluxer-aio
#      values (ports, paths), literal KEY=VALUE, applied last.
#
# Values from the environment are only ever expanded, never re-parsed, so a
# user value such as "$(id)" stays literal text.

set -o pipefail

svc="${1:?usage: fluxer-aio-env <service> <command> [args...]}"
shift
[ "$#" -gt 0 ] || { echo "fluxer-aio-env: no command for $svc" >&2; exit 64; }

envfile="/etc/fluxer-aio/env/$svc.env"
[ -r "$envfile" ] || { echo "fluxer-aio-env: missing $envfile" >&2; exit 78; }

declare -A out
while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
		'' | '#'*) continue ;;
		'!'*)
			lit="${line#!}"
			printf -v "${lit%%=*}" '%s' "${lit#*=}"
			continue
			;;
	esac
	key="${line%%=*}"
	expr="${line#*=}"
	case "$key" in
		'' | *[!A-Za-z0-9_]*) echo "fluxer-aio-env: bad key in $envfile: $key" >&2; exit 78 ;;
	esac
	# shellcheck disable=SC2034  # used via eval
	if ! eval "out[\$key]=\"$expr\""; then
		echo "fluxer-aio-env: cannot evaluate $key in $envfile" >&2
		exit 78
	fi
done <"$envfile"

for k in "${!out[@]}"; do
	export "$k=${out[$k]}"
done

for overlay in /etc/fluxer-aio/overlay/common.env "/etc/fluxer-aio/overlay/$svc.env"; do
	[ -r "$overlay" ] || continue
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in '' | '#'*) continue ;; esac
		key="${line%%=*}"
		case "$key" in
			'' | *[!A-Za-z0-9_]*) echo "fluxer-aio-env: bad key in $overlay: $key" >&2; exit 78 ;;
		esac
		export "$key=${line#*=}"
	done <"$overlay"
done

exec "$@"
