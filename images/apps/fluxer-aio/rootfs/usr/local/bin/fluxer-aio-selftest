#!/bin/bash
# fluxer-aio-selftest: runs at BUILD time (Dockerfile). There is no local
# Docker, so CI is the first place the copied programs meet this base image;
# this makes a missing library or a broken config fail the build instead of
# the first start on Unraid.

set -euo pipefail
status=0
say() { echo "[selftest] $*"; }

check_ldd() { # check_ldd <file>: every shared library must resolve
	local out
	if ! out="$(ldd "$1" 2>&1)"; then
		# "not a dynamic executable" = static binary, which is fine
		case "$out" in *"not a dynamic executable"*) say "static: $1"; return 0 ;; esac
		say "FAIL ldd $1: $out"; status=1; return 0
	fi
	if grep -q 'not found' <<<"$out"; then
		say "FAIL missing libraries for $1:"; grep 'not found' <<<"$out" | sed 's/^/    /'
		status=1
	fi
}

say "binaries"
for f in /usr/local/bin/node /usr/local/bin/fluxer-media-proxy /usr/local/bin/fluxer-server \
	/usr/local/bin/meilisearch /usr/local/bin/nats-server /usr/local/bin/livekit-server \
	/usr/local/bin/caddy; do
	[ -x "$f" ] || { say "FAIL not executable: $f"; status=1; continue; }
	check_ldd "$f"
done

say "gateway release (ERTS + NIFs)"
while IFS= read -r f; do check_ldd "$f"; done < <(
	find /opt/fluxer_gateway -type f \( -name 'beam.smp' -o -name '*.so' \) )

say "node native modules"
n=0
while IFS= read -r f; do check_ldd "$f"; n=$((n + 1)); done < <(
	find /usr/src/app -type f -name '*.node' )
say "checked $n native modules"

say "versions"
node --version
nats-server --version
meilisearch --version
livekit-server --version
caddy version

say "router config"
caddy validate --config /etc/fluxer-aio/Caddyfile --adapter caddyfile

say "generated env files"
for s in api gateway media-proxy rust; do
	FLUXER_DOMAIN=selftest.example /usr/local/bin/fluxer-aio-env "$s" /usr/bin/env >/dev/null ||
		{ say "FAIL fluxer-aio-env $s"; status=1; }
done

[ "$status" -eq 0 ] && say "all checks passed" || say "FAILED"
exit "$status"
