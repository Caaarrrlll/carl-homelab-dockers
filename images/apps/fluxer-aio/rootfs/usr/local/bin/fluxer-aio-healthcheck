#!/bin/bash
# fluxer-aio-healthcheck: Docker HEALTHCHECK. Healthy only when the router
# and every Fluxer service answer their own health check (the same checks the
# bundle's compose file uses per container). Prints the first failure.

fail() { echo "unhealthy: $1"; exit 1; }

get() { # get <url>: 200 or fail
	curl -fsS -o /dev/null -m 5 "$1" 2>/dev/null
}

get http://127.0.0.1:8080/_health || fail "router (:8080)"
get http://127.0.0.1:18080/_health || fail "api (:18080)"
get http://127.0.0.1:18081/_health/ready || fail "gateway (:18081)"
get http://127.0.0.1:8222/healthz || fail "nats (:8222)"
get http://127.0.0.1:7700/health || fail "meilisearch (:7700)"
get http://127.0.0.1:7880/ || fail "livekit (:7880)"
/command/with-contenv /usr/local/bin/fluxer-aio-env media-proxy \
	/usr/local/bin/fluxer-media-proxy healthcheck >/dev/null 2>&1 || fail "media-proxy"
/command/with-contenv /usr/local/bin/fluxer-aio-env rust \
	/usr/local/bin/fluxer-server healthcheck >/dev/null 2>&1 || fail "fluxer-server"
echo healthy
